# Application Environment (development, staging, production)
APP_ENV=development

# Server Configuration
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database (PostgreSQL / Supabase) — async connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/order_supervisor

# Temporal server (worker connection)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# LLM provider. Put real values ONLY in the git-ignored backend/.env; never commit a key.
# The code default is LLM_PROVIDER=openai (so nothing changes unless another provider is selected). This
# template selects gemini explicitly: Gemini through Google's OpenAI-compatible endpoint with the openai SDK,
# the provider that was validated live. For OpenAI set LLM_PROVIDER=openai plus LLM_API_KEY and LLM_MODEL.
# If LLM_PROVIDER is removed, the code default (openai) applies and a GEMINI_API_KEY alone is not used.
# With no key the LLM client is "not configured" and every reasoning cycle fails cleanly.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# For gemini the model and URL default to gemma-4-31b-it and the URL below. Reasoning effort is not
# sent unless you set it (gemma-4-31b-it rejects it; gemini-3.6-flash was validated earlier with "low").
LLM_MODEL=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=45
# Only for LLM_PROVIDER=openai (OpenAI Responses API): LLM_API_KEY plus LLM_MODEL.
LLM_API_KEY=
